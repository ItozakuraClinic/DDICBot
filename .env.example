# Telegram bot token from @BotFather
DDICBOT_BOT_TOKEN=

# Neon Postgres connection string (pooled endpoint)
# e.g. postgresql://neondb_owner:***@ep-withered-cherry-bid0ibk2-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Random secret for the Telegram webhook (X-Telegram-Bot-Api-Secret-Token).
# Set the same value as `secret_token` when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Vercel personal access token (CI deploys only)
VERCEL_ACCESS_TOKEN=

# P3 daily refresh cron (POST /api/cron/refresh). Vercel sends
# Authorization: Bearer <CRON_SECRET> automatically for cron-triggered calls.
CRON_SECRET=

# Vision LLM (photo → drug-name candidates, P2). Moonshot / Kimi China API
# (base URL https://api.moonshot.cn/v1 — the key is api.moonshot.cn-only).
# When unset, the photo flow answers with a "not configured" message.
DDICBOT_VISION_API_KEY=

# Optional: override the vision model (default: kimi-k3, vision-verified).
DDICBOT_VISION_MODEL=
